{
  "name": "Biblioteca de Enlaces",
  "short_name": "Biblioteca",
  "description": "Biblioteca colaborativa para guardar, clasificar y recuperar recursos compartidos.",
  "start_url": "./library.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "share_target": {
    "action": "./library.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "./icons/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
