{
  "id": "./",
  "name": "Biblioteca de Enlaces",
  "short_name": "Biblioteca",
  "description": "Biblioteca colaborativa y configurable de recursos compartidos.",
  "start_url": "./resources.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "prefer_related_applications": false,
  "share_target": {
    "action": "./resources.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "./icons/app-icon-192.svg?v=1",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/app-icon-512.svg?v=1",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/app-icon-512.svg?v=1",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
